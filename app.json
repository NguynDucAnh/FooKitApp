{
  "expo": {
    "name": "FooKitApp",
    "slug": "fookitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fookitapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.fookitapp.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fookitapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fookit cần quyền truy cập thư viện ảnh để bạn chọn ảnh đại diện.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c2152670-3c7e-4c31-96d3-630691da2d25"
      }
    },
    "owner": "ducanh152004"
  }
}
